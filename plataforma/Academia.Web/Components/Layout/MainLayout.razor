@inherits LayoutComponentBase

<header style="border-bottom: 1px solid #ddd; padding: .6rem 1.5rem; display: flex; align-items: baseline; gap: 1rem;">
    <a href="/" style="font-weight: 700; text-decoration: none; color: inherit;">🎓 Academia Cosmos</a>
    <small style="color: #888">tu código vive en tu repo; aquí vive tu avance</small>
</header>

<main style="max-width: 1100px; margin: 0 auto; padding: 1.5rem;">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>
